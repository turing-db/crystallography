.venv/
__pycache__/
*.py[cod]
.python-version
uv.lock

# ---- node -----------------------------------------------------------------
visualizer/node_modules/
visualizer/dist/
visualizer/.vite/
node_modules/

# ---- editor / os ----------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

